{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"],
			"@sekokuva-ca/agents": ["../../../sdk/packages/agents/src/index.ts"],
			"@sekokuva-ca/core": ["../../../sdk/packages/core/src/index.ts"],
			"@sekokuva-ca/core/cloud": ["../../../sdk/packages/core/src/cloud/index.ts"],
			"@sekokuva-ca/core/hub": ["../../../sdk/packages/core/src/hub/index.ts"],
			"@sekokuva-ca/core/hub/daemon-entry": [
				"../../../sdk/packages/core/src/hub/daemon/entry.ts"
			],
			"@sekokuva-ca/llms": ["../../../sdk/packages/llms/src/index.ts"],
			"@sekokuva-ca/shared": ["../../../sdk/packages/shared/src/index.ts"],
			"@sekokuva-ca/shared/storage": [
				"../../../sdk/packages/shared/src/storage/index.ts"
			],
			"@sekokuva-ca/shared/db": ["../../../sdk/packages/shared/src/db/index.ts"],
			"@sekokuva-ca/shared/*": [
				"../../../sdk/packages/shared/src/*",
				"../../../sdk/packages/shared/src/*/index.ts"
			]
		}
	},
	"include": ["sidecar/**/*.ts", "scripts/**/*.ts", "global.d.ts", "bun.mts"],
	"exclude": ["node_modules", "webview"]
}
